  carryForwardLimit          Decimal  @default(0) @db.Decimal(8, 2)
  allowHalfDay               Boolean  @default(true)
  supportingDocumentRequired Boolean  @default(false)
  documentRequiredAfterDays  Int?
  isActive                   Boolean  @default(true)
  createdById                String?  @db.Uuid
  updatedById                String?  @db.Uuid
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  balances     StaffLeaveBalance[]
  applications StaffLeaveApplication[]

  @@unique([tenantId, branchId, code])
  @@index([tenantId, branchId, isActive])
  @@index([branchId])
  @@map("staff_leave_types")
}

