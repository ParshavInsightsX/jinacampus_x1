model InAppNotification {
  id                      String                        @id @default(uuid()) @db.Uuid
  tenantId                String                        @db.Uuid
  institutionId           String?                       @db.Uuid
  branchId                String?                       @db.Uuid
  academicYearId          String?                       @db.Uuid
  legacyUserId            String?                       @map("userId") @db.Uuid
  legacyType              String?                       @map("type")
  sourceModule            InAppNotificationSourceModule @default(SYSTEM)
  eventType               String
  sourceEntityType        String?
  sourceEntityId          String?
  category                InAppNotificationCategory     @default(SYSTEM)
  priority                InAppNotificationPriority     @default(NORMAL)
  title                   String
  bodyPreview             String                        @map("message")
  deepLink                String?                       @map("actionUrl")
  iconKey                 String?
  mandatory               Boolean                       @default(false)
  requiresAcknowledgement Boolean                       @default(false)
  scheduledAt             DateTime?
  publishedAt             DateTime?
  expiresAt               DateTime?
  cancelledAt             DateTime?
  status                  InAppNotificationStatus       @default(PENDING)
  idempotencyKey          String
  templateId              String?                       @db.Uuid
  variablesJson           Json?
  safeMetadataJson        Json?
  createdById             String?                       @db.Uuid
  legacyReadAt            DateTime?                     @map("readAt")
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @default(now()) @updatedAt

  tenant        Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  institution   Institution?                    @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  branch        Branch?                         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  academicYear  AcademicYear?                   @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  legacyUser    User?                           @relation("LegacyInAppNotificationUser", fields: [legacyUserId], references: [id], onDelete: SetNull)
  template      InAppNotificationTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy     User?                           @relation("InAppNotificationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  recipients    InAppNotificationRecipient[]
  audienceRules InAppNotificationAudienceRule[]

  @@unique([tenantId, idempotencyKey], map: "in_app_notifications_tenant_idempotency_key")
  @@index([tenantId, sourceModule, category, priority, createdAt], map: "in_app_notifications_tenant_source_category_created_idx")
  @@index([tenantId, branchId, createdAt], map: "in_app_notifications_tenantId_branchId_createdAt_idx")
  @@index([status, scheduledAt], map: "in_app_notifications_status_scheduled_idx")
  @@index([expiresAt], map: "in_app_notifications_expires_idx")
  @@index([institutionId], map: "in_app_notifications_institution_idx")
  @@index([branchId], map: "in_app_notifications_branchId_idx")
  @@index([academicYearId], map: "in_app_notifications_academic_year_idx")
  @@index([legacyUserId], map: "in_app_notifications_userId_idx")
  @@index([templateId], map: "in_app_notifications_template_idx")
  @@index([createdById], map: "in_app_notifications_created_by_idx")
  @@map("in_app_notifications")
}

model InAppNotificationRecipient {
  id             String                           @id @default(uuid()) @db.Uuid
  tenantId       String                           @db.Uuid
  notificationId String                           @db.Uuid
  userId         String                           @db.Uuid
  deliveryStatus InAppNotificationRecipientStatus @default(PENDING)
  deliveredAt    DateTime?
  readAt         DateTime?
  acknowledgedAt DateTime?
  archivedAt     DateTime?
  dismissedAt    DateTime?
  failureCode    String?
  failureReason  String?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notification InAppNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId], map: "in_app_notification_recipients_notification_user_key")
  @@index([tenantId, userId, archivedAt, readAt, createdAt], map: "in_app_recipients_user_inbox_idx")
  @@index([tenantId, userId, acknowledgedAt, createdAt], map: "in_app_recipients_user_ack_idx")
  @@index([tenantId, deliveryStatus, createdAt], map: "in_app_recipients_delivery_idx")
  @@map("in_app_notification_recipients")
}

model InAppNotificationAudienceRule {
  id             String                        @id @default(uuid()) @db.Uuid
  tenantId       String                        @db.Uuid
  notificationId String                        @db.Uuid
  audienceType   InAppNotificationAudienceType
  institutionId  String?                       @db.Uuid
  branchId       String?                       @db.Uuid
  academicYearId String?                       @db.Uuid
  roleId         String?                       @db.Uuid
  userId         String?                       @db.Uuid
  criteriaJson   Json?
  createdAt      DateTime                      @default(now())

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notification InAppNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  institution  Institution?      @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  branch       Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  academicYear AcademicYear?     @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  role         Role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, notificationId], map: "in_app_audience_notification_idx")
  @@index([tenantId, audienceType, branchId], map: "in_app_audience_type_branch_idx")
  @@index([tenantId, roleId], map: "in_app_audience_role_idx")
  @@index([tenantId, userId], map: "in_app_audience_user_idx")
  @@map("in_app_notification_audience_rules")
}

model InAppNotificationTemplate {
  id                      String                          @id @default(uuid()) @db.Uuid
  tenantId                String                          @db.Uuid
  institutionId           String?                         @db.Uuid
  scopeKey                String                          @default("TENANT")
  templateKey             String
  name                    String
  sourceModule            InAppNotificationSourceModule
  category                InAppNotificationCategory
  defaultPriority         InAppNotificationPriority       @default(NORMAL)
  titleTemplate           String
  bodyTemplate            String
  deepLinkTemplate        String?
  requiredVariablesJson   Json?
  mandatory               Boolean                         @default(false)
  requiresAcknowledgement Boolean                         @default(false)
  status                  InAppNotificationTemplateStatus @default(ACTIVE)
  version                 Int                             @default(1)
  createdById             String?                         @db.Uuid
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  institution   Institution?        @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  createdBy     User?               @relation("InAppNotificationTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  notifications InAppNotification[]

  @@unique([tenantId, scopeKey, templateKey, version], map: "in_app_templates_scope_key_version_key")
  @@index([tenantId, sourceModule, category, status], map: "in_app_templates_source_category_idx")
  @@index([institutionId], map: "in_app_templates_institution_idx")
  @@map("in_app_notification_templates")
}

model InAppNotificationPreference {
  id                String                      @id @default(uuid()) @db.Uuid
  tenantId          String                      @db.Uuid
  userId            String                      @db.Uuid
  category          InAppNotificationCategory
  enabled           Boolean                     @default(true)
  minimumPriority   InAppNotificationPriority?
  quietHoursEnabled Boolean                     @default(false)
  quietStart        String?
  quietEnd          String?
  timeZone          String                      @default("Asia/Kolkata")
  digestMode        InAppNotificationDigestMode @default(IMMEDIATE)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, category], map: "in_app_preferences_user_category_key")
  @@index([tenantId, userId, enabled], map: "in_app_preferences_user_enabled_idx")
  @@map("in_app_notification_preferences")
}

model InAppNotificationSetting {
  id                       String                    @id @default(uuid()) @db.Uuid
  tenantId                 String                    @db.Uuid
  institutionId            String?                   @db.Uuid
  branchId                 String?                   @db.Uuid
  scopeKey                 String
  retentionDays            Int                       @default(365)
  defaultPriority          InAppNotificationPriority @default(NORMAL)
  quietHoursStart          String?
  quietHoursEnd            String?
  timeZone                 String                    @default("Asia/Kolkata")
  mandatoryCategoriesJson  Json?
  roleRulesJson            Json?
  acknowledgementRulesJson Json?
  featureEnabled           Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  branch      Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, scopeKey], map: "in_app_settings_tenant_scope_key")
  @@index([tenantId, institutionId, branchId], map: "in_app_settings_scope_idx")
  @@map("in_app_notification_settings")
}

model InAppNotificationOutbox {
  id             String                        @id @default(uuid()) @db.Uuid
  tenantId       String                        @db.Uuid
  eventId        String
  eventType      String
  sourceModule   InAppNotificationSourceModule
  payloadJson    Json
  idempotencyKey String
  status         InAppNotificationOutboxStatus @default(PENDING)
  attemptCount   Int                           @default(0)
  nextAttemptAt  DateTime                      @default(now())
  lockedAt       DateTime?
  lockToken      String?
  processedAt    DateTime?
  failedAt       DateTime?
  lastError      String?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey], map: "in_app_outbox_tenant_idempotency_key")
  @@index([status, nextAttemptAt, createdAt], map: "in_app_outbox_due_idx")
  @@index([tenantId, status, createdAt], map: "in_app_outbox_tenant_status_idx")
  @@map("in_app_notification_outbox")
}

model StaffAttendanceQrToken {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  branchId           String             @db.Uuid
  tokenHash          String             @unique
  purpose            StaffQrPurpose
  status             StaffQrTokenStatus @default(ACTIVE)
  validFrom          DateTime
  validUntil         DateTime
  consumedCount      Int                @default(0)
  lastUsedAt         DateTime?
  expiredAt          DateTime?
  deactivatedAt      DateTime?
  deactivatedById    String?            @db.Uuid
  deactivationReason String?
  createdById        String?            @db.Uuid
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt

  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch              Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy           User?                   @relation("StaffAttendanceQrTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deactivatedBy       User?                   @relation("StaffAttendanceQrTokenDeactivatedBy", fields: [deactivatedById], references: [id], onDelete: SetNull)
  checkInAttendances  StaffAttendanceRecord[] @relation("StaffAttendanceCheckInQrToken")
  checkOutAttendances StaffAttendanceRecord[] @relation("StaffAttendanceCheckOutQrToken")

  @@index([tenantId, branchId, validFrom, validUntil])
  @@index([tenantId, branchId, status, purpose, validUntil], map: "staff_qr_tokens_lifecycle_idx")
  @@index([validUntil])
  @@index([deactivatedById], map: "staff_qr_tokens_deactivated_by_idx")
  @@map("staff_attendance_qr_tokens")
}

model CommunicationPreference {
  id                      String                           @id @default(uuid()) @db.Uuid
  tenantId                String                           @db.Uuid
  branchId                String?                          @db.Uuid
  ownerType               CommunicationPreferenceOwnerType
  ownerId                 String                           @db.Uuid
  whatsappEnabled         Boolean                          @default(false)
  whatsappNumber          String?
  attendanceAlertsEnabled Boolean                          @default(false)
  weeklySummaryEnabled    Boolean                          @default(false)
  monthlySummaryEnabled   Boolean                          @default(false)
  leaveUpdatesEnabled     Boolean                          @default(false)
  consentCapturedAt       DateTime?
  consentSource           String?
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, ownerType, ownerId])
  @@index([tenantId, branchId])
  @@index([tenantId, ownerType])
  @@map("communication_preferences")
}

model NotificationTemplate {
  id                   String                       @id @default(uuid()) @db.Uuid
  tenantId             String                       @db.Uuid
  branchId             String?                      @db.Uuid
  channel              NotificationChannel
  templateKey          String
  providerTemplateName String
  languageCode         String                       @default("en")
  category             NotificationTemplateCategory @default(UTILITY)
  isActive             Boolean                      @default(true)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, channel, templateKey])
  @@index([tenantId, channel, isActive])
  @@map("notification_templates")
}

model NotificationOutbox {
  id             String                    @id @default(uuid()) @db.Uuid
  tenantId       String                    @db.Uuid
  branchId       String?                   @db.Uuid
  academicYearId String?                   @db.Uuid
  channel        NotificationChannel
  templateKey    String
  recipientType  NotificationRecipientType
  recipientId    String                    @db.Uuid
  recipientPhone String
  payloadJson    Json
  status         NotificationOutboxStatus  @default(QUEUED)
  idempotencyKey String                    @unique
  scheduledFor   DateTime                  @default(now())
  sentAt         DateTime?
  failedAt       DateTime?
  failureReason  String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  academicYear AcademicYear?             @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  deliveryLogs NotificationDeliveryLog[]

  @@index([tenantId, status, scheduledFor])
  @@index([tenantId, recipientType, recipientId])
  @@index([tenantId, branchId, createdAt])
  @@map("notification_outbox")
}

model NotificationDeliveryLog {
  id                String                     @id @default(uuid()) @db.Uuid
  tenantId          String                     @db.Uuid
  outboxId          String                     @db.Uuid
  provider          WhatsAppProvider
  providerMessageId String?
  status            NotificationDeliveryStatus
  rawStatusJson     Json?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime                   @default(now())

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outbox NotificationOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@index([tenantId, outboxId, createdAt])
  @@index([providerMessageId])
  @@index([tenantId, status, createdAt])
  @@map("notification_delivery_logs")
}

model WhatsAppIntegrationSetting {
  id                     String           @id @default(uuid()) @db.Uuid
  tenantId               String           @db.Uuid
  branchId               String?          @db.Uuid
  provider               WhatsAppProvider @default(META_CLOUD)
  phoneNumberId          String?
  businessAccountId      String?
  accessTokenEncrypted   String?
  webhookVerifyTokenHash String?
  isEnabled              Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, isEnabled])
  @@index([tenantId, provider])
  @@map("whatsapp_integration_settings")
}
