model PlatformAdministrator {
  id                         String                      @id @default(uuid()) @db.Uuid
  email                      String                      @unique
  displayName                String?
  status                     PlatformAdministratorStatus @default(ACTIVE)
  canManagePrincipalRecovery Boolean                     @default(false)
  lastLoginAt                DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  credential               PlatformAdministratorCredential?
  sessions                 PlatformAdministratorSession[]
  auditLogs                PlatformAuditLog[]               @relation("PlatformAuditActor")
  principalRecoveryReviews PrincipalPasswordResetRequest[]  @relation("PrincipalRecoveryReviewedBy")

  @@index([status])
  @@map("platform_administrators")
}

model PlatformAdministratorCredential {
  id                String   @id @default(uuid()) @db.Uuid
  administratorId   String   @unique @db.Uuid
  passwordHash      String
  passwordUpdatedAt DateTime @default(now())
  mustChange        Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  administrator PlatformAdministrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)

  @@map("platform_administrator_credentials")
}

model PlatformAdministratorSession {
  id              String    @id @default(uuid()) @db.Uuid
  administratorId String    @db.Uuid
  tokenHash       String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  administrator PlatformAdministrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)

  @@index([administratorId, revokedAt])
  @@index([expiresAt])
  @@map("platform_administrator_sessions")
}

model PlatformAuditLog {
  id                   String   @id @default(uuid()) @db.Uuid
  actorAdministratorId String?  @db.Uuid
  action               String
  entityType           String
  entityId             String?
  beforeJson           Json?
  afterJson            Json?
  metadataJson         Json?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime @default(now())

  actor PlatformAdministrator? @relation("PlatformAuditActor", fields: [actorAdministratorId], references: [id], onDelete: SetNull)

  @@index([actorAdministratorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("platform_audit_logs")
}

model PrincipalPasswordResetRequest {
  id                        String                              @id @default(uuid()) @db.Uuid
  tenantId                  String                              @db.Uuid
  institutionId             String                              @db.Uuid
  principalUserId           String                              @db.Uuid
  identifierType            PrincipalRecoveryIdentifierType
  identifierHash            String
  status                    PrincipalPasswordResetRequestStatus @default(PENDING)
  resetMethod               PrincipalPasswordResetMethod?
  reviewedByAdministratorId String?                             @db.Uuid
  reviewedAt                DateTime?
  identityVerifiedAt        DateTime?
  reviewRemarks             String?
  requestedIpAddress        String?
  requestedUserAgent        String?
  resetTokenHash            String?                             @unique
  resetTokenExpiresAt       DateTime?
  resetTokenUsedAt          DateTime?
  temporaryPasswordIssuedAt DateTime?
  notificationStatus        PrincipalRecoveryNotificationStatus @default(MANUAL_DELIVERY_REQUIRED)
  notificationTargetMasked  String?
  rejectedAt                DateTime?
  completedAt               DateTime?
  createdAt                 DateTime                            @default(now())
  updatedAt                 DateTime                            @updatedAt

  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  institution             Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  principalUser           User                   @relation(fields: [principalUserId], references: [id], onDelete: Cascade)
  reviewedByAdministrator PlatformAdministrator? @relation("PrincipalRecoveryReviewedBy", fields: [reviewedByAdministratorId], references: [id], onDelete: SetNull, map: "principal_password_reset_requests_reviewedByAdministratorId_fke")

  @@index([tenantId, status, createdAt])
  @@index([institutionId, status, createdAt], map: "principal_password_reset_requests_institutionId_status_createdA")
  @@index([principalUserId, status, createdAt], map: "principal_password_reset_requests_principalUserId_status_create")
  @@index([reviewedByAdministratorId, reviewedAt], map: "principal_password_reset_requests_reviewedByAdministratorId_rev")
  @@index([resetTokenExpiresAt])
  @@map("principal_password_reset_requests")
}

model PrincipalPasswordRecoveryAttempt {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String?  @db.Uuid
  identifierHash String
  ipHash         String?
  createdAt      DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([identifierHash, createdAt], map: "principal_password_recovery_attempts_identifierHash_createdAt_i")
  @@index([ipHash, createdAt])
  @@index([tenantId, createdAt])
  @@map("principal_password_recovery_attempts")
}

