model GradebookAssessment {
  id                    String                    @id @default(uuid()) @db.Uuid
  tenantId              String                    @db.Uuid
  branchId              String                    @db.Uuid
  academicYearId        String                    @db.Uuid
  classSectionId        String                    @db.Uuid
  classSectionSubjectId String                    @db.Uuid
  code                  String
  title                 String
  type                  GradebookAssessmentType
  assessmentDate        DateTime                  @db.Date
  maxMarks              Decimal                   @db.Decimal(8, 2)
  passMarks             Decimal                   @db.Decimal(8, 2)
  status                GradebookAssessmentStatus @default(OPEN)
  createdById           String                    @db.Uuid
  publishedById         String?                   @db.Uuid
  publishedAt           DateTime?
  cancelledById         String?                   @db.Uuid
  cancelledAt           DateTime?
  cancellationReason    String?                   @db.Text
  reopenReason          String?                   @db.Text
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch              Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  academicYear        AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classSection        ClassSection        @relation(fields: [classSectionId], references: [id], onDelete: Restrict)
  classSectionSubject ClassSectionSubject @relation(fields: [classSectionSubjectId], references: [id], onDelete: Restrict)
  createdBy           User                @relation("GradebookAssessmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy         User?               @relation("GradebookAssessmentPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  cancelledBy         User?               @relation("GradebookAssessmentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  marks               GradebookMark[]

  @@unique([tenantId, classSectionSubjectId, code])
  @@index([tenantId, branchId, academicYearId, status])
  @@index([tenantId, classSectionId, assessmentDate])
  @@index([tenantId, classSectionSubjectId, status])
  @@map("gradebook_assessments")
}

model GradebookMark {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @db.Uuid
  branchId       String              @db.Uuid
  academicYearId String              @db.Uuid
  assessmentId   String              @db.Uuid
  enrollmentId   String              @db.Uuid
  studentId      String              @db.Uuid
  status         GradebookMarkStatus @default(GRADED)
  marksObtained  Decimal?            @db.Decimal(8, 2)
  remarks        String?             @db.Text
  enteredById    String              @db.Uuid
  enteredAt      DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  assessment   GradebookAssessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  enrollment   Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enteredBy    User                @relation("GradebookMarkEnteredBy", fields: [enteredById], references: [id], onDelete: Restrict)

  @@unique([tenantId, assessmentId, enrollmentId])
  @@index([tenantId, branchId, academicYearId, assessmentId])
  @@index([tenantId, studentId, academicYearId])
  @@index([tenantId, enrollmentId])
  @@map("gradebook_marks")
}

model StudentPromotionBatch {
  id                          String                      @id @default(uuid()) @db.Uuid
  tenantId                    String                      @db.Uuid
  branchId                    String                      @db.Uuid
  sourceAcademicYearId        String                      @db.Uuid
  targetAcademicYearId        String                      @db.Uuid
  sourceClassSectionId        String                      @db.Uuid
  defaultTargetClassSectionId String                      @db.Uuid
  status                      StudentPromotionBatchStatus @default(COMPLETED)
  effectiveDate               DateTime                    @db.Date
  remarks                     String?                     @db.Text
  resultsPublicationConfirmed Boolean                     @default(false)
  selectedCount               Int
  excludedCount               Int
  outcomeSummary              Json
  createdById                 String                      @db.Uuid
  reversedAt                  DateTime?
  reversedById                String?                     @db.Uuid
  reversalReason              String?                     @db.Text
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  tenant                    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch                    Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sourceAcademicYear        AcademicYear           @relation("StudentPromotionSourceAcademicYear", fields: [sourceAcademicYearId], references: [id], onDelete: Restrict)
  targetAcademicYear        AcademicYear           @relation("StudentPromotionTargetAcademicYear", fields: [targetAcademicYearId], references: [id], onDelete: Restrict)
  sourceClassSection        ClassSection           @relation("StudentPromotionSourceClassSection", fields: [sourceClassSectionId], references: [id], onDelete: Restrict)
  defaultTargetClassSection ClassSection           @relation("StudentPromotionDefaultTargetClassSection", fields: [defaultTargetClassSectionId], references: [id], onDelete: Restrict)
  createdBy                 User                   @relation("StudentPromotionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reversedBy                User?                  @relation("StudentPromotionReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)
  items                     StudentPromotionItem[]

  @@index([tenantId, branchId, sourceAcademicYearId, sourceClassSectionId], map: "promotion_batch_source_scope_idx")
  @@index([tenantId, branchId, targetAcademicYearId, defaultTargetClassSectionId], map: "promotion_batch_target_scope_idx")
  @@index([tenantId, status, createdAt], map: "promotion_batch_status_created_idx")
  @@map("student_promotion_batches")
}

model StudentPromotionItem {
  id                           String                  @id @default(uuid()) @db.Uuid
  tenantId                     String                  @db.Uuid
  branchId                     String                  @db.Uuid
  batchId                      String                  @db.Uuid
  studentId                    String                  @db.Uuid
  sourceEnrollmentId           String                  @db.Uuid
  targetEnrollmentId           String?                 @unique @db.Uuid
  targetClassSectionId         String?                 @db.Uuid
  selected                     Boolean                 @default(true)
  outcome                      StudentPromotionOutcome
  decisionRemarks              String?                 @db.Text
  sourceEnrollmentStatusBefore EnrollmentStatus
  sourceEnrollmentLeftOnBefore DateTime?               @db.Date
  studentStatusBefore          StudentStatus
  studentLeftAtBefore          DateTime?               @db.Date
  reversedAt                   DateTime?
  reversedById                 String?                 @db.Uuid
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch             Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  batch              StudentPromotionBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  student            Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  sourceEnrollment   Enrollment            @relation("StudentPromotionSourceEnrollment", fields: [sourceEnrollmentId], references: [id], onDelete: Restrict)
  targetEnrollment   Enrollment?           @relation("StudentPromotionTargetEnrollment", fields: [targetEnrollmentId], references: [id], onDelete: Restrict)
  targetClassSection ClassSection?         @relation("StudentPromotionItemTargetClassSection", fields: [targetClassSectionId], references: [id], onDelete: Restrict)
  reversedBy         User?                 @relation("StudentPromotionItemReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, batchId, sourceEnrollmentId], map: "promotion_item_batch_source_key")
  @@index([tenantId, branchId, studentId], map: "promotion_item_student_idx")
  @@index([tenantId, sourceEnrollmentId, outcome], map: "promotion_item_source_outcome_idx")
  @@index([tenantId, batchId, selected], map: "promotion_item_batch_selected_idx")
  @@map("student_promotion_items")
}

model StudentAttendanceRecord {
