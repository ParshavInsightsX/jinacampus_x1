  leaveType         StaffLeaveType                @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  actionedBy        User?                         @relation("StaffLeaveApplicationActionedBy", fields: [actionedById], references: [id], onDelete: SetNull)
  actions           StaffLeaveApplicationAction[]
  documents         StaffLeaveDocument[]
  attendanceRecords StaffAttendanceRecord[]

