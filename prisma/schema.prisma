generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum InstitutionStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  LOCKED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PlatformAdministratorStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserType {
  OWNER
  STAFF
  PARENT
  STUDENT
  SYSTEM
}

enum OtpPurpose {
  ADMIN_LOGIN
  FORGOT_PASSWORD
}

enum PasskeyChallengePurpose {
  REGISTRATION
  AUTHENTICATION
}

enum PermissionModule {
  CAMPUS_CORE
  ACADEMIA
  GRADEBOOK
  FEEDESK
  STAFFBOARD
  NOTIFICATIONS
  SCHOOLCAST
  INSIGHTBOARD
  CAMPUSFLEET
  BOOKNEST
  ASSETROOM
  SYSTEM
}

enum RoleScope {
  TENANT
  BRANCH
  ACADEMIC_YEAR
}

enum RoleAssignmentScope {
  TENANT
  BRANCH
  ACADEMIC_YEAR
}

enum TenantPlan {
  TRIAL
  STARTER
  GROWTH
  ENTERPRISE
}

enum StudentAttendanceMode {
  DAILY
  PERIOD
}

enum AttendanceSessionType {
  FULL_DAY
  MORNING
  AFTERNOON
  PERIOD
}

enum AcademicRecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  ALUMNI
  TRANSFERRED
  WITHDRAWN
}

enum StudentDocumentType {
  PASSPORT_PHOTO
  TRANSFER_CERTIFICATE
  BIRTH_CERTIFICATE
  IDENTITY_PROOF
  PREVIOUS_SCHOOL_REPORT
  CASTE_CERTIFICATE
  MIGRATION_CERTIFICATE
  MEDICAL_CERTIFICATE
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  TRANSFERRED
  WITHDRAWN
  CANCELLED
  COMPLETED
}

enum StudentPromotionBatchStatus {
  COMPLETED
  REVERSED
}

enum StudentPromotionOutcome {
  PROMOTED
  NOT_PROMOTED
  REPEAT_SAME_CLASS
  TRANSFERRED
  SCHOOL_LEFT
  RESULT_PENDING
  PROMOTION_WITHHELD
  EXCLUDED
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  GRANDFATHER
  GRANDMOTHER
  UNCLE
  AUNT
  SIBLING
  OTHER
}

enum StudentAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  EXCUSED
  NOT_MARKED
}

enum AcademicCalendarEntryType {
  HOLIDAY
  NON_WORKING_DAY
}

enum AcademicCalendarAudience {
  STUDENTS
  TEACHING_STAFF
  NON_TEACHING_STAFF
}

enum AcademicCalendarEntryStatus {
  ACTIVE
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  NOT_SPECIFIED
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum SubjectType {
  CORE
  ELECTIVE
  OPTIONAL
  CO_CURRICULAR
}

enum GradebookAssessmentType {
  UNIT_TEST
  PERIODIC_TEST
  HALF_YEARLY
  ANNUAL
  PROJECT
  PRACTICAL
  OTHER
}

enum GradebookAssessmentStatus {
  OPEN
  PUBLISHED
  CANCELLED
}

enum GradebookMarkStatus {
  GRADED
  ABSENT
  EXEMPT
}

enum StaffType {
  TEACHER
  ADMIN
  ACCOUNTANT
  LIBRARIAN
  DRIVER
  HELPER
  SECURITY
  PEON
  CLEANING_STAFF
  MANAGEMENT
  OTHER
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  TERMINATED
}

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  WEEK_OFF
  HOLIDAY
  NOT_MARKED
}

enum StaffAttendanceSource {
  QR_SCAN
  MANUAL_ADMIN
  IMPORT
  BIOMETRIC
}

enum StaffLeaveApplicationStatus {
  PENDING
  CLARIFICATION_REQUIRED
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

enum StaffLeaveDuration {
  FULL_DAY
  FIRST_HALF
  SECOND_HALF
}

enum StaffLeaveActionType {
  SUBMITTED
  MODIFIED
  CLARIFICATION_REQUESTED
  CLARIFICATION_PROVIDED
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

enum StaffLeaveApprovalMode {
  PRINCIPAL_ONLY
  DESIGNATED_APPROVERS
  PRINCIPAL_OR_DESIGNATED
}

enum StaffQrPurpose {
  CHECK_IN
  CHECK_OUT
}

enum StaffQrTokenStatus {
  ACTIVE
  DEACTIVATED
  EXPIRED
}

enum CommunicationPreferenceOwnerType {
  GUARDIAN
  STAFF
}

enum NotificationChannel {
  WHATSAPP
}

enum NotificationTemplateCategory {
  UTILITY
}

enum NotificationRecipientType {
  GUARDIAN
  STAFF
}

enum NotificationOutboxStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum NotificationDeliveryStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppProvider {
  META_CLOUD
  BSP
  DRY_RUN
}

enum StudentAttendanceNotificationMode {
  DISABLED
  EXCEPTION_ONLY
  ALL_STATUSES
}

model Tenant {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  slug         String       @unique
  status       TenantStatus @default(ACTIVE)
  plan         TenantPlan   @default(TRIAL)
  legalName    String?
  supportEmail String?
  phone        String?
  website      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  institutions             Institution[]
  branches                 Branch[]
  academicYears            AcademicYear[]
  academicCalendarEntries  AcademicCalendarEntry[]
  users                    User[]
  roles                    Role[]
  rolePermissions          RolePermission[]
  roleAssignments          UserRoleAssignment[]
  branchAccesses           UserBranchAccess[]
  sessions                 Session[]
  loginOtps                LoginOtp[]
  passkeyCredentials       PasskeyCredential[]
  passkeyChallenges        PasskeyChallenge[]
  tenantSettings           TenantSettings?
  attendanceSettings       AttendanceSetting[]
  auditLogs                AuditLog[]
  classes                  Class[]
  sections                 Section[]
  classSections            ClassSection[]
  subjects                 Subject[]
  students                 Student[]
  studentDocuments         StudentDocument[]
  guardians                Guardian[]
  studentGuardianLinks     StudentGuardianLink[]
  enrollments              Enrollment[]
  studentPromotionBatches  StudentPromotionBatch[]
  studentPromotionItems    StudentPromotionItem[]
  studentAttendanceRecords StudentAttendanceRecord[]
  classSectionSubjects     ClassSectionSubject[]
  gradebookAssessments     GradebookAssessment[]
  gradebookMarks           GradebookMark[]
  staffProfiles            StaffProfile[]
  staffAttendanceRecords   StaffAttendanceRecord[]
  staffAttendanceQrTokens  StaffAttendanceQrToken[]
  staffLeaveSettings       StaffLeaveSetting[]
  staffLeaveTypes          StaffLeaveType[]
  staffLeaveApprovers      StaffLeaveApprover[]
  staffLeaveBalances       StaffLeaveBalance[]
  staffLeaveApplications   StaffLeaveApplication[]
  staffLeaveActions        StaffLeaveApplicationAction[]
  staffLeaveDocuments      StaffLeaveDocument[]
  inAppNotifications       InAppNotification[]
  communicationPreferences CommunicationPreference[]
  notificationTemplates    NotificationTemplate[]
  notificationOutboxItems  NotificationOutbox[]
  notificationDeliveryLogs NotificationDeliveryLog[]
  whatsAppSettings         WhatsAppIntegrationSetting[]

  @@index([status])
  @@map("tenants")
}

model PlatformAdministrator {
  id          String                      @id @default(uuid()) @db.Uuid
  email       String                      @unique
  displayName String?
  status      PlatformAdministratorStatus @default(ACTIVE)
  lastLoginAt DateTime?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  credential PlatformAdministratorCredential?
  sessions   PlatformAdministratorSession[]
  auditLogs  PlatformAuditLog[]               @relation("PlatformAuditActor")

  @@index([status])
  @@map("platform_administrators")
}

model PlatformAdministratorCredential {
  id                String   @id @default(uuid()) @db.Uuid
  administratorId   String   @unique @db.Uuid
  passwordHash      String
  passwordUpdatedAt DateTime @default(now())
  mustChange        Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  administrator PlatformAdministrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)

  @@map("platform_administrator_credentials")
}

model PlatformAdministratorSession {
  id              String    @id @default(uuid()) @db.Uuid
  administratorId String    @db.Uuid
  tokenHash       String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  administrator PlatformAdministrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)

  @@index([administratorId, revokedAt])
  @@index([expiresAt])
  @@map("platform_administrator_sessions")
}

model PlatformAuditLog {
  id                   String   @id @default(uuid()) @db.Uuid
  actorAdministratorId String?  @db.Uuid
  action               String
  entityType           String
  entityId             String?
  beforeJson           Json?
  afterJson            Json?
  metadataJson         Json?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime @default(now())

  actor PlatformAdministrator? @relation("PlatformAuditActor", fields: [actorAdministratorId], references: [id], onDelete: SetNull)

  @@index([actorAdministratorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("platform_audit_logs")
}

model Institution {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  name          String
  displayName   String?
  code          String
  status        InstitutionStatus @default(ACTIVE)
  board         String?
  medium        String?
  logoUrl       String?
  logoObjectKey String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  country       String            @default("India")
  createdById   String?           @db.Uuid
  updatedById   String?           @db.Uuid
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches                Branch[]
  academicYears           AcademicYear[]
  academicCalendarEntries AcademicCalendarEntry[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("institutions")
}

model Branch {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  institutionId String       @db.Uuid
  name          String
  code          String
  status        BranchStatus @default(ACTIVE)
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  country       String       @default("India")
  phone         String?
  email         String?
  timezone      String       @default("Asia/Kolkata")
  createdById   String?      @db.Uuid
  updatedById   String?      @db.Uuid
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant                   Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  institution              Institution                   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicCalendarEntries  AcademicCalendarEntry[]
  userBranchAccesses       UserBranchAccess[]
  attendanceSetting        AttendanceSetting?
  auditLogs                AuditLog[]
  classSections            ClassSection[]
  students                 Student[]
  studentDocuments         StudentDocument[]
  enrollments              Enrollment[]
  studentPromotionBatches  StudentPromotionBatch[]
  studentPromotionItems    StudentPromotionItem[]
  studentAttendanceRecords StudentAttendanceRecord[]
  classSectionSubjects     ClassSectionSubject[]
  gradebookAssessments     GradebookAssessment[]
  gradebookMarks           GradebookMark[]
  staffProfiles            StaffProfile[]
  staffAttendanceRecords   StaffAttendanceRecord[]
  staffAttendanceQrTokens  StaffAttendanceQrToken[]
  staffLeaveSetting        StaffLeaveSetting?
  staffLeaveTypes          StaffLeaveType[]
  staffLeaveApprovers      StaffLeaveApprover[]
  staffLeaveBalances       StaffLeaveBalance[]
  staffLeaveApplications   StaffLeaveApplication[]
  staffLeaveActions        StaffLeaveApplicationAction[]
  staffLeaveDocuments      StaffLeaveDocument[]
  inAppNotifications       InAppNotification[]
  communicationPreferences CommunicationPreference[]
  notificationTemplates    NotificationTemplate[]
  notificationOutboxItems  NotificationOutbox[]
  whatsAppSettings         WhatsAppIntegrationSetting[]

  @@unique([tenantId, code])
  @@index([tenantId, institutionId])
  @@index([tenantId, status])
  @@map("branches")
}

model AcademicYear {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  institutionId String             @db.Uuid
  name          String
  startDate     DateTime           @db.Date
  endDate       DateTime           @db.Date
  status        AcademicYearStatus @default(DRAFT)
  isActive      Boolean            @default(false)
  createdById   String?            @db.Uuid
  updatedById   String?            @db.Uuid
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  institution              Institution               @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  auditLogs                AuditLog[]
  classSections            ClassSection[]
  enrollments              Enrollment[]
  sourcePromotionBatches   StudentPromotionBatch[]   @relation("StudentPromotionSourceAcademicYear")
  targetPromotionBatches   StudentPromotionBatch[]   @relation("StudentPromotionTargetAcademicYear")
  studentAttendanceRecords StudentAttendanceRecord[]
  classSectionSubjects     ClassSectionSubject[]
  gradebookAssessments     GradebookAssessment[]
  gradebookMarks           GradebookMark[]
  staffAttendanceRecords   StaffAttendanceRecord[]
  academicCalendarEntries  AcademicCalendarEntry[]
  notificationOutboxItems  NotificationOutbox[]

  @@unique([tenantId, institutionId, name])
  @@index([tenantId, institutionId, status])
  @@index([tenantId, institutionId, isActive])
  @@map("academic_years")
}

model AcademicCalendarEntry {
  id                 String                      @id @default(uuid()) @db.Uuid
  tenantId           String                      @db.Uuid
  institutionId      String                      @db.Uuid
  branchId           String?                     @db.Uuid
  academicYearId     String                      @db.Uuid
  entryType          AcademicCalendarEntryType   @default(HOLIDAY)
  name               String
  description        String?
  startDate          DateTime                    @db.Date
  endDate            DateTime                    @db.Date
  audiences          AcademicCalendarAudience[]
  status             AcademicCalendarEntryStatus @default(ACTIVE)
  cancellationReason String?
  cancelledAt        DateTime?
  createdById        String?                     @db.Uuid
  updatedById        String?                     @db.Uuid
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  institution            Institution             @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  branch                 Branch?                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  academicYear           AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  staffAttendanceRecords StaffAttendanceRecord[]

  @@index([tenantId, institutionId, academicYearId, status, startDate, endDate], map: "academic_calendar_institution_dates_idx")
  @@index([tenantId, branchId, academicYearId, status, startDate, endDate], map: "academic_calendar_branch_dates_idx")
  @@map("academic_calendar_entries")
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @db.Uuid
  email         String
  phone         String?
  firstName     String
  middleName    String?
  lastName      String?
  displayName   String?
  userType      UserType   @default(STAFF)
  status        UserStatus @default(INVITED)
  lastLoginAt   DateTime?
  invitedAt     DateTime?
  activatedAt   DateTime?
  deactivatedAt DateTime?
  createdById   String?    @db.Uuid
  updatedById   String?    @db.Uuid
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant                        Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  passwordCredential            PasswordCredential?
  sessions                      Session[]
  loginOtps                     LoginOtp[]
  passkeyCredentials            PasskeyCredential[]
  passkeyChallenges             PasskeyChallenge[]
  roleAssignments               UserRoleAssignment[]
  branchAccesses                UserBranchAccess[]
  auditLogs                     AuditLog[]                    @relation("AuditActor")
  classSectionsAsTeacher        ClassSection[]                @relation("ClassSectionTeacher")
  markedStudentAttendance       StudentAttendanceRecord[]     @relation("StudentAttendanceMarkedBy")
  correctedStudentAttendance    StudentAttendanceRecord[]     @relation("StudentAttendanceCorrectedBy")
  staffProfile                  StaffProfile?                 @relation("StaffProfileUser")
  markedStaffAttendance         StaffAttendanceRecord[]       @relation("StaffAttendanceMarkedBy")
  updatedStaffAttendance        StaffAttendanceRecord[]       @relation("StaffAttendanceUpdatedBy")
  createdStaffQrTokens          StaffAttendanceQrToken[]      @relation("StaffAttendanceQrTokenCreatedBy")
  deactivatedStaffQrTokens      StaffAttendanceQrToken[]      @relation("StaffAttendanceQrTokenDeactivatedBy")
  staffLeaveApproverScopes      StaffLeaveApprover[]          @relation("StaffLeaveApproverUser")
  actionedStaffLeave            StaffLeaveApplication[]       @relation("StaffLeaveApplicationActionedBy")
  staffLeaveActions             StaffLeaveApplicationAction[] @relation("StaffLeaveActionActor")
  inAppNotifications            InAppNotification[]
  createdPromotionBatches       StudentPromotionBatch[]       @relation("StudentPromotionCreatedBy")
  reversedPromotionBatches      StudentPromotionBatch[]       @relation("StudentPromotionReversedBy")
  reversedPromotionItems        StudentPromotionItem[]        @relation("StudentPromotionItemReversedBy")
  classSectionSubjectsTaught    ClassSectionSubject[]         @relation("ClassSectionSubjectTeacher")
  createdGradebookAssessments   GradebookAssessment[]         @relation("GradebookAssessmentCreatedBy")
  publishedGradebookAssessments GradebookAssessment[]         @relation("GradebookAssessmentPublishedBy")
  cancelledGradebookAssessments GradebookAssessment[]         @relation("GradebookAssessmentCancelledBy")
  enteredGradebookMarks         GradebookMark[]               @relation("GradebookMarkEnteredBy")

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId, status])
  @@index([tenantId, userType])
  @@map("users")
}

model PasswordCredential {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  passwordHash      String
  passwordUpdatedAt DateTime @default(now())
  mustChange        Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginOtp {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @db.Uuid
  userId     String     @db.Uuid
  phone      String
  otpHash    String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, phone, purpose])
  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("login_otps")
}

model PasskeyCredential {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  userId       String    @db.Uuid
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  deviceType   String
  backedUp     Boolean   @default(false)
  transports   String[]  @default([])
  name         String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, lastUsedAt])
  @@map("passkey_credentials")
}

model PasskeyChallenge {
  id             String                  @id @default(uuid()) @db.Uuid
  tenantId       String                  @db.Uuid
  userId         String?                 @db.Uuid
  purpose        PasskeyChallengePurpose
  challenge      String                  @unique
  identifierHash String?
  identifierType String?
  expiresAt      DateTime
  consumedAt     DateTime?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime                @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, purpose])
  @@index([tenantId, ipAddress, createdAt])
  @@index([expiresAt])
  @@map("passkey_challenges")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  module      PermissionModule
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
  @@index([isActive])
  @@map("permissions")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  code        String
  name        String
  description String?
  scope       RoleScope @default(TENANT)
  isSystem    Boolean   @default(false)
  isMutable   Boolean   @default(true)
  isActive    Boolean   @default(true)
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  assignments     UserRoleAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  userId       String              @db.Uuid
  roleId       String              @db.Uuid
  scopeType    RoleAssignmentScope @default(TENANT)
  scopeId      String              @default("TENANT")
  assignedById String?             @db.Uuid
  startsAt     DateTime?
  endsAt       DateTime?
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, roleId, scopeType, scopeId])
  @@index([tenantId, userId, isActive])
  @@index([tenantId, roleId])
  @@map("user_role_assignments")
}

model UserBranchAccess {
  id                        String   @id @default(uuid()) @db.Uuid
  tenantId                  String   @db.Uuid
  userId                    String   @db.Uuid
  branchId                  String   @db.Uuid
  canAccessAllAcademicYears Boolean  @default(true)
  isPrimary                 Boolean  @default(false)
  isActive                  Boolean  @default(true)
  grantedById               String?  @db.Uuid
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, branchId])
  @@index([tenantId, branchId])
  @@index([tenantId, userId, isActive])
  @@map("user_branch_accesses")
}

model TenantSettings {
