  totalDays          Decimal                     @db.Decimal(8, 2)
  reason             String
  status             StaffLeaveApplicationStatus @default(PENDING)
  staffClarification String?
  approverRemarks    String?
  actionedById       String?                     @db.Uuid
  actionedAt         DateTime?
  submittedAt        DateTime                    @default(now())
  cancelledAt        DateTime?
  withdrawnAt        DateTime?
