# Copy to ops.env.local and load it in the operator shell before Compose commands.
# Keep the generated Alertmanager configuration and all destination URLs outside Git.
SCHOOLCAST_WORKER_ENV_FILE=./worker.env.local
SCHOOLCAST_WORKER_IMAGE_TAG=local
SCHOOLCAST_ALERTMANAGER_CONFIG_FILE=./generated/alertmanager.yml
SCHOOLCAST_GRAFANA_ADMIN_USER=schoolcast-ops
SCHOOLCAST_GRAFANA_ADMIN_PASSWORD=
SCHOOLCAST_GRAFANA_ROOT_URL=http://localhost:3300
SCHOOLCAST_GRAFANA_COOKIE_SECURE=false
SCHOOLCAST_ALERT_PRIMARY_WEBHOOK_URL=
SCHOOLCAST_ALERT_BACKUP_WEBHOOK_URL=
