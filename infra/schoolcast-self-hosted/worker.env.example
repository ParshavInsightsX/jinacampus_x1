# Copy to worker.env.local on the worker host and replace every placeholder.
# Never commit worker.env.local. This example is not a usable deployment secret set.
DATABASE_URL=postgresql://postgres.replaceproject:replace-me@db.replaceproject.supabase.co:6543/postgres?pgbouncer=true&connection_limit=3
DIRECT_URL=postgresql://postgres.replaceproject:replace-me@db.replaceproject.supabase.co:6543/postgres?pgbouncer=true&connection_limit=3
APP_URL=https://replace-with-approved-app.example
WEBAUTHN_ORIGIN=https://replace-with-approved-app.example
SESSION_SECRET=replace-with-at-least-32-characters
PASSWORD_PEPPER=replace-with-existing-server-pepper
SUPABASE_URL=https://replaceproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SCHOOLCAST_RELEASE_SCOPE=FULL
SCHOOLCAST_DATA_ENCRYPTION_KEY=replace-with-approved-encryption-key
SCHOOLCAST_STORAGE_BUCKET=schoolcast-private
SCHOOLCAST_WORKER_DEPLOYMENT_ENVIRONMENT=STAGING
SCHOOLCAST_WORKER_DATABASE_PROJECT_REF=replaceproject
SCHOOLCAST_WORKER_REPLICA_ID=worker-a
SCHOOLCAST_EXTERNAL_HEARTBEAT_URL=https://replace-monitor.example/checks/replace-worker-a
SCHOOLCAST_EXTERNAL_HEARTBEAT_TIMEOUT_MS=3000
SCHOOLCAST_WORKER_HEALTH_PORT=9464
SCHOOLCAST_WORKER_POLL_INTERVAL_MS=5000
SCHOOLCAST_WORKER_BATCH_SIZE=50
SCHOOLCAST_WORKER_CONCURRENCY=10
SCHOOLCAST_WORKER_LEASE_SECONDS=120
SCHOOLCAST_WORKER_ALERT_QUEUE_DEPTH=500
SCHOOLCAST_WORKER_ALERT_OLDEST_AGE_SECONDS=600
SCHOOLCAST_WORKER_HEARTBEAT_TIMEOUT_SECONDS=300
SCHOOLCAST_MALWARE_SCANNER_MODE=DISABLED
SCHOOLCAST_CLAMAV_HOST=replace-with-private-scanner-host
SCHOOLCAST_CLAMAV_PORT=3310
SCHOOLCAST_CLAMAV_TIMEOUT_MS=12000
SCHOOLCAST_SCAN_MAX_ATTEMPTS=5
SCHOOLCAST_DOMAIN_EVENT_MAX_ATTEMPTS=8
SCHOOLCAST_RESEND_API_KEY=
SCHOOLCAST_RESEND_WEBHOOK_SECRET=
