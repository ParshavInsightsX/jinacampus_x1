FROM node:24.18.0-bookworm-slim AS base

RUN apt-get update \
  && apt-get install --yes --no-install-recommends ca-certificates dumb-init openssl \
  && rm -rf /var/lib/apt/lists/*

FROM base AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY prisma ./prisma
RUN npx --no-install prisma generate

COPY tsconfig.json ./tsconfig.json
COPY src ./src
COPY scripts/run-schoolcast-worker.ts ./scripts/run-schoolcast-worker.ts

RUN npx --no-install esbuild scripts/run-schoolcast-worker.ts \
  --bundle \
  --platform=node \
  --format=cjs \
  --target=node24 \
  --outfile=dist/schoolcast-worker.cjs \
  --external:@prisma/client \
  --external:.prisma/client

FROM base AS runtime

WORKDIR /app
ENV NODE_ENV=production
ENV SCHOOLCAST_WORKER_HEALTH_PORT=9464

COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/node_modules/@prisma/client ./node_modules/@prisma/client
COPY --from=build --chown=node:node /app/node_modules/.prisma ./node_modules/.prisma

USER node

EXPOSE 9464
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:9464/livez').then((response) => { if (!response.ok) process.exit(1); }).catch(() => process.exit(1));"]

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/schoolcast-worker.cjs"]