{
  "name": "jinacampus-phase1-campuscore",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.1.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:raw": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "brand:qr:generate": "node --import tsx scripts/generate-website-qr.ts",
    "demo:qa:reset": "tsx prisma/demo-qa-reset.ts",
    "platform-admin:provision": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/provision-platform-administrator.ts",
    "platform-admin:principal-recovery-access": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/set-platform-principal-recovery-access.ts",
    "smoke:notifications:whatsapp": "tsx scripts/whatsapp-notification-db-smoke.ts",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@simplewebauthn/browser": "^13.0.0",
    "@simplewebauthn/server": "^13.0.0",
    "@supabase/supabase-js": "2.112.0",
    "clsx": "^2.1.1",
    "exceljs": "4.4.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "pdf-lib": "^1.17.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "8.5.25",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "uuid": "11.1.1"
  }
}
