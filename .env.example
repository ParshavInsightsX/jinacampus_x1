# Supabase/Vercel values belong in Vercel Project Settings -> Environment
# Variables. Never commit real database URLs, passwords, or application secrets.
# DATABASE_URL: Supavisor transaction-pooled runtime URL for Vercel.
# DIRECT_URL: direct Supabase database URL for Prisma migration commands.
DATABASE_URL=""
DIRECT_URL=""
APP_URL=""
WEBAUTHN_ORIGIN=""
WEBAUTHN_RP_ID=""
SESSION_COOKIE_NAME="jc_session"
SESSION_TTL_DAYS="7"
SESSION_SECRET=""
PASSWORD_PEPPER=""

# Private Supabase Storage for student admission documents. The service-role
# key is server-only and must never use an EXPO_PUBLIC_/NEXT_PUBLIC_ prefix.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STUDENT_DOCUMENTS_BUCKET="student-documents"
STUDENT_DOCUMENT_MAX_BYTES="4000000"

# Private supporting documents attached to staff leave applications.
STAFF_LEAVE_DOCUMENTS_BUCKET="staff-leave-documents"
STAFF_LEAVE_DOCUMENT_MAX_BYTES="4000000"

# Private GradeBook storage for validated marks imports and generated report
# cards. Keep this bucket private; downloads use short-lived signed URLs.
GRADEBOOK_STORAGE_BUCKET="gradebook-private"
GRADEBOOK_IMPORT_MAX_BYTES="10000000"
GRADEBOOK_REPORT_CARD_MAX_BYTES="5000000"

# Public school-branding images. Uploads still run server-side through the
# Administrator Portal; only the rendered logo asset is publicly readable.
INSTITUTION_LOGOS_BUCKET="institution-logos"
INSTITUTION_LOGO_MAX_BYTES="2000000"

# Commercial onboarding is disabled by default. Configure these values outside
# source control, run the seed once, then disable bootstrap again.
COMMERCIAL_BOOTSTRAP_ENABLED="false"
RESET_SEED_ADMIN_PASSWORD="false"
SEED_TENANT_NAME=""
SEED_TENANT_SLUG=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PHONE=""
SEED_ADMIN_TEMP_PASSWORD=""
SEED_INSTITUTION_NAME=""
SEED_INSTITUTION_CODE=""
SEED_BRANCH_NAME=""
SEED_BRANCH_CODE=""
SEED_ACADEMIC_YEAR_NAME=""
SEED_ACADEMIC_YEAR_START_DATE=""
SEED_ACADEMIC_YEAR_END_DATE=""

# Optional local development fixtures. This flag is rejected in production.
DEV_DEMO_SEED_ENABLED="false"
DEV_DEMO_USER_PASSWORD=""
DEV_DEMO_STAFF_PASSWORD=""

# OTP delivery adapter. Do not commit provider credentials.
OTP_QA_ENABLED="false"
SMS_PROVIDER="dev"
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_OTP_TEMPLATE_ID=""

# WhatsApp notification foundation. Keep DRY_RUN for local/dev unless a provider
# integration is approved and configured with real secrets outside git.
WHATSAPP_PROVIDER_MODE="DRY_RUN"
WHATSAPP_WEBHOOK_VERIFY_TOKEN_SHA256=""
WHATSAPP_APP_SECRET=""

# Production defaults to DISABLED when this server-only variable is absent.
# IN_APP_CORE permits immediate in-app notices for authenticated school users
# only. FULL remains prohibited until every worker, scanner, provider, recovery,
# and approval gate passes. Never expose this through NEXT_PUBLIC_ variables.
SCHOOLCAST_RELEASE_SCOPE="DISABLED"
SCHOOLCAST_DATA_ENCRYPTION_KEY=""
SCHOOLCAST_STORAGE_BUCKET="schoolcast-private"
SCHOOLCAST_ATTACHMENT_MAX_BYTES="10000000"
SCHOOLCAST_SIGNED_URL_TTL_SECONDS="60"
SCHOOLCAST_WORKER_SECRET=""
SCHOOLCAST_WORKER_ENABLED="false"
SCHOOLCAST_WORKER_DEPLOYMENT_ENVIRONMENT="LOCAL"
# Required for hosted workers. It must match the intended Supabase project
# reference inside DATABASE_URL so a worker cannot silently target another DB.
SCHOOLCAST_WORKER_DATABASE_PROJECT_REF=""
# Each hosted replica needs a stable identity and a unique external HTTPS
# dead-man check URL. The URL is a server-only secret and must never be logged.
SCHOOLCAST_WORKER_REPLICA_ID=""
SCHOOLCAST_EXTERNAL_HEARTBEAT_URL=""
SCHOOLCAST_EXTERNAL_HEARTBEAT_TIMEOUT_MS="3000"
# Attachment scanning is fail-closed. Keep DISABLED unless a reachable ClamAV
# service has been provisioned; unscanned files remain quarantined and cannot publish.
SCHOOLCAST_MALWARE_SCANNER_MODE="DISABLED"
SCHOOLCAST_CLAMAV_HOST="127.0.0.1"
SCHOOLCAST_CLAMAV_PORT="3310"
SCHOOLCAST_CLAMAV_TIMEOUT_MS="12000"
SCHOOLCAST_SCAN_MAX_ATTEMPTS="5"
# Durable PostgreSQL outbox worker controls. Production uses independently
# supervised CONTINUOUS worker replicas. The authenticated cron route is a
# separately controlled fallback and must not share the generic CRON_SECRET.
SCHOOLCAST_DOMAIN_EVENT_MAX_ATTEMPTS="8"
SCHOOLCAST_WORKER_RUN_MODE="ONCE"
SCHOOLCAST_WORKER_POLL_INTERVAL_MS="5000"
SCHOOLCAST_WORKER_BATCH_SIZE="50"
SCHOOLCAST_WORKER_CONCURRENCY="10"
SCHOOLCAST_WORKER_LEASE_SECONDS="120"
SCHOOLCAST_WORKER_ALERT_QUEUE_DEPTH="500"
SCHOOLCAST_WORKER_ALERT_OLDEST_AGE_SECONDS="600"
SCHOOLCAST_WORKER_HEALTH_PORT="9464"
SCHOOLCAST_WORKER_HEARTBEAT_TIMEOUT_SECONDS="300"
SCHOOLCAST_RESEND_API_KEY=""
SCHOOLCAST_RESEND_WEBHOOK_SECRET=""
SCHOOLCAST_META_ACCESS_TOKEN=""
SCHOOLCAST_META_WEBHOOK_SECRET=""
# Required only by the separate attendance-notification cron endpoint. Do not
# reuse this value as SCHOOLCAST_WORKER_SECRET.
CRON_SECRET=""
